# Virtual environment
.venv/
venv/

# Byte-compiled
__pycache__/
*.py[cod]

# Training outputs: checkpoints are ~430 MB each
checkpoints/
artifacts/*.out
artifacts/*.txt
artifacts/*.png
artifacts/*.svg
artifacts/*.pdf

# Split files are reproducible from runner/build_cifar100_splits.py, but small
# enough to keep if you want exact reproducibility. Uncomment to exclude.
# artifacts/*.json

# Datasets are not redistributed here
dataset/
*.tar.gz

# LaTeX build products. The report PDF in docs/ is committed deliberately, since it is
# the thing people actually read; everything else here is regenerated by pdflatex.
*.aux
*.log
*.toc
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
!artifacts/*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
